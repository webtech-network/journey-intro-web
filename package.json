{
  "name": "lab-jsonserver",
  "version": "1.0.0",
  "description": "Aplicação Web com backend baseado no JSON Server",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/assets/css/app.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/assets/css/app.css --watch",
    "prestart": "node server/db/seed.js && npm run build:css",
    "start": "npx json-server@0.17.4 --watch ./server/db/db.json --static ./public --host 0.0.0.0 --port 3000 --routes ./server/api/routes.json"
  },
  "keywords": [],
  "author": "Rommel Vieira Carneiro",
  "license": "ISC",
  "dependencies": {
    "express": "^4.17.1",
    "json-server": "^0.17.4"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
